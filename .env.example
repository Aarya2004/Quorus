# Quorus auth configuration (see ADR 0005). Auth is fail-closed: the server
# refuses to boot unless exactly one of the modes below is configured.

# --- Production (token mode): per-Member bearer tokens ---
# A JSON object mapping each Member's secret token to their Member name.
# Mint tokens with e.g. `openssl rand -hex 16`. On Fly set this as a SECRET
# (`fly secrets set QUORUS_TOKENS=...`), never in fly.toml [env].
# QUORUS_TOKENS={"tk_aarya":"aarya","tk_arav":"arav"}

# --- Local dev (open mode): no token, identity from the x-quorus-member header ---
# `npm run dev` already sets this for you. Open mode is refused on a Fly target
# (FLY_APP_NAME present) or when NODE_ENV=production.
# QUORUS_INSECURE=true
